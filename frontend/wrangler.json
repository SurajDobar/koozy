{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koozy",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist-astro",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "BACKEND_URL": "https://koozy-backend.onrender.com"
  },
  "routes": [
    {
      "pattern": "koozy.live",
      "custom_domain": true
    },
    {
      "pattern": "www.koozy.live",
      "custom_domain": true
    }
  ]
}
