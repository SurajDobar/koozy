---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    category: 'Joining & Gameplay',
    items: [
      {
        question: 'Do participants need to create an account or download an app?',
        answer: 'No. Players join as guests without an account, email, or app download. They simply open /join/ in any browser, enter the 5-letter PIN, and pick a nickname.'
      },
      {
        question: 'Do players need to look at a separate projector or shared Zoom screen?',
        answer: 'No. Unlike traditional tools that require a projector or screen share, Koozy displays questions and answer options directly on each player\'s screen. Everyone can play in the same room or remotely.'
      },
      {
        question: 'What happens if a player accidentally refreshes or loses connection?',
        answer: 'If a player refreshes, their browser automatically reconnects to the active quiz with their selected answers saved.'
      },
      {
        question: 'Can participants change their answers before submitting?',
        answer: 'Yes. Players can change their selected answers at any time until they tap Submit Answers or the timer runs out.'
      }
    ]
  },
  {
    category: 'Hosting & Live Management',
    items: [
      {
        question: 'How do hosts create an account?',
        answer: 'Hosts sign in with their Google account to save quizzes, host live games, and generate questions with AI. Players never need an account.'
      },
      {
        question: 'Can hosts remove disruptive participants from the waiting room?',
        answer: 'Yes. Hosts have full moderation authority in the live lobby. Hosts can admit pending players, kick unwanted nicknames, and lock the room when the quiz starts.'
      },
      {
        question: 'Can a host end a live quiz session early?',
        answer: 'Yes. If all participants have submitted their answers before the timer runs out, the host can click "End Quiz Early" to reveal the final leaderboard immediately.'
      }
    ]
  },
  {
    category: 'Google Gemini AI Quiz Generator',
    items: [
      {
        question: 'What AI powers the quiz generator?',
        answer: 'Koozy uses Google Gemini AI to generate balanced 4-option multiple-choice questions from simple text prompts.'
      },
      {
        question: 'What is the daily AI generation quota?',
        answer: 'Each host receives 8 full quiz generations per day. The quota resets automatically every 24 hours.'
      },
      {
        question: 'Can I edit AI-generated questions before launching them live?',
        answer: 'Yes. Every question generated by AI can be edited, reordered, modified, or deleted in your host quiz editor before hosting.'
      }
    ]
  },
  {
    category: 'Pricing & Technology',
    items: [
      {
        question: 'Is Koozy free to use?',
        answer: 'Yes! Koozy is 100% free for both hosts and participants. Live hosting, scoring, leaderboards, and AI quiz creation are all included.'
      },
      {
        question: 'Which browsers and devices are supported?',
        answer: 'Koozy works on all modern web browsers (Chrome, Safari, Firefox, Edge) across phones, tablets, Chromebooks, and laptops.'
      },
      {
        question: 'How is scoring calculated?',
        answer: 'Each correct answer earns 1,000 points. Incorrect or unsubmitted questions receive 0 points. Players see their scorecard and rankings at the end.'
      }
    ]
  }
];

// Flatten for FAQPage Schema
const schemaFaqItems = faqs.flatMap(cat => cat.items).map(item => ({
  '@type': 'Question',
  'name': item.question,
  'acceptedAnswer': {
    '@type': 'Answer',
    'text': item.answer
  }
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': schemaFaqItems
};
---

<BaseLayout
  title="Frequently Asked Questions (FAQ) — Koozy"
  description="Quick, clear answers about hosting and playing live quizzes on Koozy. Learn about PIN joining, AI quiz generation, device support, and pricing."
  noindex={false}
  schema={schema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-16">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-block text-xs uppercase font-extrabold tracking-widest text-[#6c4de8] mb-3 bg-[#eeeafd] px-3.5 py-1.5 rounded-full border border-[#c9bfff]">
        Help & FAQs
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-[#191817] tracking-tight leading-tight mb-4">
        Frequently Asked <span class="font-hand text-[#6c4de8] font-normal">Questions.</span>
      </h1>
      <p class="text-base text-[#77736c] leading-relaxed">
        Everything you need to know about joining live rooms, hosting multiplayer quizzes, and generating questions with AI.
      </p>
    </div>

    <!-- FAQ Categories -->
    <div class="space-y-12">
      {faqs.map(category => (
        <section>
          <h2 class="text-xl sm:text-2xl font-black text-[#191817] mb-6 pb-2 border-b-2 border-[#191817] flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#6c4de8]"></span>
            <span>{category.category}</span>
          </h2>

          <div class="space-y-4">
            {category.items.map(item => (
              <div class="kz-card-tactile p-6 bg-white">
                <h3 class="font-black text-base sm:text-lg text-[#191817] mb-2">
                  {item.question}
                </h3>
                <p class="text-xs sm:text-sm text-[#77736c] leading-relaxed">
                  {item.answer}
                </p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Still have questions? -->
    <div class="mt-16 text-center p-8 bg-[#fffdf7] border-2 border-[#191817] rounded-3xl shadow-[4px_4px_0_#191817]">
      <h3 class="text-xl font-black text-[#191817] mb-2">Still have questions?</h3>
      <p class="text-xs sm:text-sm text-[#77736c] mb-6">
        Have feedback, suggestions, or want to report a bug? We would love to hear from you.
      </p>
      <a href="/contact/" class="kz-btn-primary px-6 py-2.5 rounded-xl font-bold text-xs inline-block">
        Contact Us &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
