---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    category: 'Joining & Gameplay',
    items: [
      {
        question: 'Do participants need to create an account or download an app?',
        answer: 'No. Participants can join 100% as guests without creating an account, downloading an app, or providing an email address. They simply visit /join/ on any web browser, enter the 5-letter Game PIN and their chosen nickname.'
      },
      {
        question: 'Do players need to look at a separate projector or shared Zoom screen?',
        answer: 'No. While traditional projector setups (like Kahoot Classic) display questions on a shared screen and only color buttons on phones, Koozy is completely device-native: the full question text and all four answer options appear directly on each player\'s screen. This makes Koozy ideal for remote, hybrid, or in-person sessions without any projector.'
      },
      {
        question: 'What happens if a player accidentally refreshes or loses connection?',
        answer: 'Koozy utilizes tab-scoped session tokens stored securely in sessionStorage. If a participant refreshes their browser during an active session, they automatically reconnect to their ongoing quiz session with their previous draft answers intact.'
      },
      {
        question: 'Can participants change their answers before submitting?',
        answer: 'Yes. Until a participant taps the "Submit Answers" button or the global timer runs out, they can freely navigate between questions and update their selected options.'
      }
    ]
  },
  {
    category: 'Hosting & Live Management',
    items: [
      {
        question: 'How do hosts create an account?',
        answer: 'Hosts sign in securely using their Google Account via Google OAuth 2.0. This allows hosts to save their quizzes to a personal library, access session analytics, and manage daily AI generation quotas.'
      },
      {
        question: 'Can hosts remove disruptive participants from the waiting room?',
        answer: 'Yes. Hosts have full moderation authority in the live lobby and dashboard. Hosts can admit pending players, kick unwanted or inappropriate nicknames, and lock the room when the quiz starts.'
      },
      {
        question: 'Can a host end a live quiz session early?',
        answer: 'Yes. If all participants have submitted their answers before the timer runs out, the host can click "End Quiz Early" to immediately calculate scores and transition to the final podium leaderboard.'
      }
    ]
  },
  {
    category: 'Google Gemini AI Quiz Generator',
    items: [
      {
        question: 'What AI powers the quiz generator?',
        answer: 'Koozy integrates directly with Google Gemini AI to generate high-quality, balanced multiple-choice questions from simple text prompts.'
      },
      {
        question: 'What is the daily AI generation quota?',
        answer: 'Each authenticated host receives 8 full quiz generations per day. The quota resets automatically every 24 hours, ensuring fair, reliable performance for all users.'
      },
      {
        question: 'Can I edit AI-generated questions before launching them live?',
        answer: 'Yes. Every question generated by Gemini is populated directly into your host quiz editor. You can edit question text, modify distractors, adjust the correct answer key, reorder questions, or delete any question before hosting.'
      }
    ]
  },
  {
    category: 'Pricing & Technology',
    items: [
      {
        question: 'Is Koozy free to use?',
        answer: 'Yes! Koozy is free for hosts and participants. All core hosting features, real-time WebSocket lobbies, participant leaderboards, and the daily AI generation quota are available without cost.'
      },
      {
        question: 'Which browsers and devices are supported?',
        answer: 'Koozy is built on modern web standards and works seamlessly on all modern browsers (Chrome, Safari, Firefox, Edge) across mobile smartphones, tablets, Chromebooks, and desktop computers.'
      },
      {
        question: 'How is scoring calculated?',
        answer: 'Each correct answer awards 1,000 points. Incorrect or unsubmitted questions receive 0 points. Participants receive a full scorecard with accuracy breakdown and correct answer keys after the session concludes.'
      }
    ]
  }
];

// Flatten for FAQPage Schema
const schemaFaqItems = faqs.flatMap(cat => cat.items).map(item => ({
  '@type': 'Question',
  'name': item.question,
  'acceptedAnswer': {
    '@type': 'Answer',
    'text': item.answer
  }
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': schemaFaqItems
};
---

<BaseLayout
  title="Frequently Asked Questions — Live Quizzes & AI Maker | Koozy"
  description="Got questions about Koozy? Find clear answers regarding game PINs, player accounts, Google sign-in, Gemini AI limits, WebSocket latency, and device support."
  noindex={false}
  schema={schema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-16">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-block text-xs uppercase font-extrabold tracking-widest text-[#6c4de8] mb-3 bg-[#eeeafd] px-3.5 py-1.5 rounded-full border border-[#c9bfff]">
        Help & FAQs
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-[#191817] tracking-tight leading-tight mb-4">
        Frequently Asked <span class="font-hand text-[#6c4de8] font-normal">Questions.</span>
      </h1>
      <p class="text-base text-[#77736c] leading-relaxed">
        Everything you need to know about joining live rooms, hosting multiplayer quizzes, and generating questions with AI.
      </p>
    </div>

    <!-- FAQ Categories -->
    <div class="space-y-12">
      {faqs.map(category => (
        <section>
          <h2 class="text-xl sm:text-2xl font-black text-[#191817] mb-6 pb-2 border-b-2 border-[#191817] flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#6c4de8]"></span>
            <span>{category.category}</span>
          </h2>

          <div class="space-y-4">
            {category.items.map(item => (
              <div class="kz-card-tactile p-6 bg-white">
                <h3 class="font-black text-base sm:text-lg text-[#191817] mb-2">
                  {item.question}
                </h3>
                <p class="text-xs sm:text-sm text-[#77736c] leading-relaxed">
                  {item.answer}
                </p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Still have questions? -->
    <div class="mt-16 text-center p-8 bg-[#fffdf7] border-2 border-[#191817] rounded-3xl shadow-[4px_4px_0_#191817]">
      <h3 class="text-xl font-black text-[#191817] mb-2">Still have questions?</h3>
      <p class="text-xs sm:text-sm text-[#77736c] mb-6">
        Have feedback, suggestions, or want to report a bug? We would love to hear from you.
      </p>
      <a href="/contact/" class="kz-btn-primary px-6 py-2.5 rounded-xl font-bold text-xs inline-block">
        Contact Us &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
