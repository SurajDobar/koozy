---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site || 'https://koozy.live').toString().replace(/\/$/, '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': 'Contact Koozy',
  'url': `${siteUrl}/contact/`,
  'description': 'Get in touch with the Koozy team. Submit feedback, report bugs directly via email at surajdobardev@gmail.com, or inquire about classroom and team quiz hosting.',
  'mainEntity': {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    'name': 'Koozy',
    'url': `${siteUrl}/`,
    'email': 'surajdobardev@gmail.com'
  }
};
---

<BaseLayout
  title="Contact & Support — Koozy"
  description="Get in touch with the Koozy team. Submit feedback, report bugs directly via email at surajdobardev@gmail.com, or inquire about classroom and team quiz hosting."
  noindex={false}
  schema={schema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-16">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-block text-xs uppercase font-extrabold tracking-widest text-[#6c4de8] mb-3 bg-[#eeeafd] px-3.5 py-1.5 rounded-full border border-[#c9bfff]">
        We Would Love to Hear From You
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-[#191817] tracking-tight leading-tight mb-4">
        Get in <span class="font-hand text-[#6c4de8] font-normal">Touch.</span>
      </h1>
      <p class="text-base text-[#77736c] leading-relaxed">
        Whether you are an educator with classroom feedback, a developer with ideas, or a host who ran into a bug, we are here to help.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Direct Email Support & Bug Reports -->
      <div class="kz-card-tactile p-6 sm:p-8 bg-white flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[#eeeafd] text-[#6c4de8] border-2 border-[#191817] flex items-center justify-center font-bold text-lg mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </div>
          <h2 class="text-xl font-black text-[#191817] mb-2">
            Direct Email Support
          </h2>
          <p class="text-xs sm:text-sm text-[#77736c] leading-relaxed mb-4">
            Have questions, found a bug, or need assistance with a live quiz session? Reach out directly to our developer team via email.
          </p>
          <div class="text-xs text-[#77736c] bg-[#f7f5ef] p-3 rounded-xl border border-[#d8d3ca] space-y-1.5">
            <div>
              <strong class="text-[#191817]">Email:</strong>{" "}
              <a href="mailto:surajdobardev@gmail.com" class="text-[#6c4de8] font-bold hover:underline break-all">
                surajdobardev@gmail.com
              </a>
            </div>
            <div><strong class="text-[#191817]">Support:</strong> Bug reports, quiz host questions & inquiries</div>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-[#d8d3ca]">
          <a
            href="mailto:surajdobardev@gmail.com"
            class="kz-btn-secondary py-2.5 px-4 rounded-xl text-xs font-bold block text-center transition-all"
          >
            Send an Email &rarr;
          </a>
        </div>
      </div>

      <!-- General Feedback & Inquiries -->
      <div class="kz-card-tactile p-6 sm:p-8 bg-white flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-[#e6f9ff] text-[#05cdff] border-2 border-[#191817] flex items-center justify-center font-bold text-lg mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
          </div>
          <h2 class="text-xl font-black text-[#191817] mb-2">
            Feedback & Community Support
          </h2>
          <p class="text-xs sm:text-sm text-[#77736c] leading-relaxed mb-4">
            Got an idea for improving the live quiz experience or prompt engineering in the Gemini generator? We review community feedback continuously to refine our platform.
          </p>
          <div class="text-xs text-[#77736c] bg-[#f7f5ef] p-3 rounded-xl border border-[#d8d3ca] space-y-1.5">
            <div><strong class="text-[#191817]">Response Time:</strong> Typically within 1-2 business days</div>
            <div><strong class="text-[#191817]">Support Scope:</strong> Live rooms, host tools, and AI generator</div>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-[#d8d3ca]">
          <a
            href="/faq/"
            class="kz-btn-primary py-2.5 px-4 rounded-xl text-xs font-bold block text-center transition-all"
          >
            Check FAQs First &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- What to Include in a Bug Report -->
    <div class="kz-card p-6 sm:p-8 bg-[#fffdf7] border-2 border-[#191817] rounded-3xl shadow-[4px_4px_0_#191817]">
      <h3 class="font-black text-lg text-[#191817] mb-2">Reporting a Live Session Issue?</h3>
      <p class="text-xs sm:text-sm text-[#77736c] leading-relaxed mb-4">
        To help us diagnose connection drops or scoring glitches quickly when emailing <a href="mailto:surajdobardev@gmail.com" class="text-[#6c4de8] font-bold hover:underline">surajdobardev@gmail.com</a>, please include:
      </p>
      <ul class="list-disc list-inside text-xs text-[#77736c] space-y-1.5">
        <li>Your browser name and version (e.g. Chrome on Windows, Safari on iOS)</li>
        <li>The 5-letter Game PIN used during the live session</li>
        <li>Whether you were acting as the Host or a Participant</li>
        <li>A brief description of what happened when the issue occurred</li>
      </ul>
    </div>
  </div>
</BaseLayout>
