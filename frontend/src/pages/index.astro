---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowKoozyWorksSection from '../components/HowKoozyWorksSection.jsx';
import FeatureShowcaseSection from '../components/FeatureShowcaseSection.jsx';
import AudienceSection from '../components/AudienceSection.jsx';

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site || 'https://koozy.live').toString().replace(/\/$/, '');

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      'name': 'Koozy',
      'url': `${siteUrl}/`,
      'logo': `${siteUrl}/favicon-96x96.png`,
      'description': 'Free real-time online multiplayer quiz and live trivia platform with Google Gemini AI.',
      'contactPoint': {
        '@type': 'ContactPoint',
        'email': 'surajdobardev@gmail.com',
        'contactType': 'customer support'
      }
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': `${siteUrl}/`,
      'name': 'Koozy',
      'description': 'Free online multiplayer quiz platform and live trivia games.',
      'publisher': {
        '@id': `${siteUrl}/#organization`
      },
      'inLanguage': 'en-US'
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#webapp`,
      'name': 'Koozy',
      'url': `${siteUrl}/`,
      'description': 'Create an online multiplayer quiz game, share a 5-letter PIN, and get everyone answering on a live global timer. Simple for hosts, fast for players.',
      'applicationCategory': 'GameApplication',
      'operatingSystem': 'All',
      'browserRequirements': 'Requires JavaScript and modern web browser with WebSocket support',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD'
      },
      'publisher': {
        '@id': `${siteUrl}/#organization`
      },
      'featureList': [
        'Device-native question rendering without separate projector',
        'Synchronized global countdown timer',
        '5-letter PIN instant room joining without app download',
        'Google Gemini AI multiple choice question generator',
        'Real-time WebSocket lobby and live host dashboard',
        'Automated scoring and leaderboard'
      ]
    }
  ]
};

const faqItems = [
  {
    question: 'What is an online multiplayer quiz?',
    answer:
      'An online multiplayer quiz is a live trivia game where multiple participants answer questions simultaneously from their own devices. On Koozy, questions and four choices appear directly on each player\'s screen, synchronized to a live countdown timer managed over WebSockets without requiring a projector.'
  },
  {
    question: 'How do I create and host a multiplayer quiz on Koozy?',
    answer:
      'Sign in with Google, go to your host dashboard, and create a quiz manually or generate balanced multiple-choice questions in seconds using Google Gemini AI. When ready, click "Start Live Session" to open the waiting lobby, share the 5-letter PIN, and launch the game when players join.'
  },
  {
    question: 'How do players join a quiz using a PIN?',
    answer:
      'Players navigate to /join/ on any web browser, enter the host\'s 5-letter Game PIN, and pick a nickname. They enter the live waiting room instantly without needing passwords or invitations.'
  },
  {
    question: 'Do players need to download an app or create an account?',
    answer:
      'No. Players join 100% as guests on phones, tablets, or laptops. No app store download, installation, or account registration is needed for participants.'
  },
  {
    question: 'Can I use my own questions in Koozy?',
    answer:
      'Yes. Hosts have complete creative control to write custom questions and choices from scratch, adjust countdown timers, reorder questions, or import and export JSON question sets. You can also edit and customize AI-generated drafts.'
  },
  {
    question: 'Is Koozy free to use?',
    answer:
      'Yes. Koozy is completely free for hosts and players. Real-time multiplayer rooms, live leaderboards, automated scoring, and daily Gemini AI quiz generations are included without paywalls.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': `<p>${item.answer}</p>`
    }
  }))
};
---

<BaseLayout
  title="Online Multiplayer Quiz — Play Free Live Trivia Games | Koozy"
  description="Play Koozy, the free online multiplayer quiz game. Create custom trivia or generate questions with AI, share a 5-letter PIN, and play live with friends on any screen."
  ogTitle="Online Multiplayer Quiz — Play Free Live Trivia Games | Koozy"
  ogDescription="Play Koozy, the free online multiplayer quiz game. Create custom trivia or generate questions with AI, share a 5-letter PIN, and play live with friends on any screen."
  ogImage="/og-image.png"
  noindex={false}
  schema={schema}
  showFooterCta={true}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-16">
    <!-- Hero Section (EXACT Hero Preserved) -->
    <section class="flex flex-col items-center justify-center text-center relative py-8 md:py-16">
      <div class="hidden md:block absolute left-4 top-4 font-hand text-2xl text-[#77736c] -rotate-6 select-none">
        learning doesn't have to be boring ✦
      </div>
      <div class="hidden md:block absolute right-4 bottom-4 font-hand text-2xl text-[#77736c] rotate-6 select-none">
        ready? <span class="text-[#6c4de8]">→</span>
      </div>

      <div class="inline-block text-xs uppercase font-extrabold tracking-widest text-[#6c4de8] mb-4 bg-[#eeeafd] px-3.5 py-1.5 rounded-full border border-[#c9bfff]">
        Live Multiplayer Quizzes ✦ Free & Fast
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-[#191817] max-w-4xl leading-[0.95] my-4">
        Make learning fun with <span class="font-hand text-[#6c4de8] font-normal">live quizzes.</span>
      </h1>

      <p class="text-[#77736c] text-base md:text-xl max-w-2xl mx-auto mt-2 mb-10 leading-relaxed font-medium">
        Create a quiz. Share the 5-letter PIN. Everyone plays from their own screen on a live countdown timer — no app install needed.
      </p>

      <!-- Primary Action CTAs -->
      <div class="flex flex-wrap gap-4 justify-center items-center">
        <a
          href="/host/quizzes/"
          class="kz-btn-primary px-8 py-3.5 rounded-xl font-bold text-base flex items-center gap-2"
        >
          <span>Host a Quiz</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a
          href="/join/"
          class="kz-btn-secondary px-8 py-3.5 rounded-xl font-bold text-base flex items-center gap-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-[#6c4de8]"
          >
            <line x1="6" x2="10" y1="12" y2="12" />
            <line x1="8" x2="8" y1="10" y2="14" />
            <line x1="15" x2="15.01" y1="13" y2="13" />
            <line x1="18" x2="18.01" y1="11" y2="11" />
            <rect width="20" height="12" x="2" y="6" rx="6" />
          </svg>
          <span>Join a Quiz with PIN</span>
        </a>
      </div>

      <!-- Quick Trust Indicators -->
      <div class="mt-8 flex flex-wrap justify-center items-center gap-6 text-xs font-bold text-[#77736c]">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-[#00cc05]"></span>
          <span>No App Download</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-[#6c4de8]"></span>
          <span>Google Gemini AI Inside</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-[#05cdff]"></span>
          <span>Realtime WebSockets</span>
        </div>
      </div>

      <!-- Tilted & Titled YouTube Video Card (Calibrated height & placement to barely clear the text) -->
      <div
        class="mt-8 lg:mt-0 lg:absolute lg:right-0 xl:right-2 lg:bottom-10 xl:bottom-10 z-20 w-full max-w-xs sm:max-w-sm lg:w-[260px] xl:w-[285px] transition-all duration-300 ease-out group hover:scale-[1.02] rotate-1.5 sm:rotate-2 hover:rotate-0"
      >
        <div
          class="kz-card-tactile bg-white p-2 sm:p-2.5 border-2 border-[#191817] shadow-[4px_4px_0_#191817] rounded-2xl text-left"
        >
          <!-- Window Header / Title Bar -->
          <div class="flex items-center justify-between pb-1.5 mb-1.5 border-b border-[#d8d3ca]">
            <div class="flex items-center gap-1 min-w-0">
              <span class="w-2 h-2 rounded-full bg-[#ff5f56] border border-[#191817]"></span>
              <span class="w-2 h-2 rounded-full bg-[#ffbd2e] border border-[#191817]"></span>
              <span class="w-2 h-2 rounded-full bg-[#27c93f] border border-[#191817]"></span>
              <span class="ml-1.5 font-mono text-[10px] sm:text-[11px] font-bold text-[#191817] truncate">
                Koozy is liveee ✦
              </span>
            </div>
            <span
              class="shrink-0 text-[9px] font-mono font-bold uppercase tracking-wider text-[#6c4de8] bg-[#eeeafd] px-1.5 py-0.5 rounded-full border border-[#c9bfff]"
            >
              Demo
            </span>
          </div>

          <!-- Video Player Container -->
          <div class="relative w-full aspect-video rounded-lg overflow-hidden border border-[#191817] bg-[#191817]">
            <iframe
              src="https://www.youtube-nocookie.com/embed/y8F1BwhzwfQ?rel=0"
              title="Koozy is liveee"
              class="w-full h-full block"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>

          <!-- Footer Caption / Subtle Playful Note -->
          <div class="mt-1.5 pt-0.5 flex items-center justify-between text-[10px] font-hand text-[#77736c] select-none">
            <span class="flex items-center gap-1">
              <span class="text-[#ff0000]">▶</span> Watch in action
            </span>
            <span class="text-[#6c4de8] font-bold group-hover:translate-x-0.5 transition-transform">
              see it live ✦
            </span>
          </div>
        </div>
      </div>

      <!-- Subtle Scroll Cue -->
      <a
        href="#how-koozy-works"
        class="mt-10 inline-flex flex-col items-center text-xs font-bold text-[#77736c] hover:text-[#6c4de8] transition-colors group cursor-pointer"
        aria-label="Scroll to see how Koozy works"
      >
        <span class="font-hand text-base group-hover:translate-y-0.5 transition-transform">
          see how it works ↓
        </span>
      </a>
    </section>

    <!-- SECTION 2: See how Koozy works — Interactive Visual Walkthrough -->
    <HowKoozyWorksSection client:visible />

    <!-- SECTION 3: Horizontal Scroll-Driven Feature Showcase (Cards A, B, C) -->
    <FeatureShowcaseSection client:visible />

    <!-- SECTION 4: Compact "Why Koozy?" (1-2s scan rule) -->
    <section class="py-14 md:py-18 border-t border-[#d8d3ca]">
      <div class="text-center max-w-xl mx-auto mb-8">
        <h2 class="text-3xl sm:text-4xl font-black text-[#191817] tracking-tight">
          Why Koozy?
        </h2>
        <p class="text-base text-[#77736c] font-medium mt-1">
          A live multiplayer quiz platform built for screens. Real-time quizzes made for humans.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Card 1: DEVICE-NATIVE -->
        <div class="kz-card-tactile p-5 bg-white flex flex-col justify-between shadow-[3.5px_3.5px_0_#191817]">
          <div>
            <div class="w-10 h-10 rounded-xl bg-[#e6f9ff] text-[#05cdff] border-2 border-[#191817] shadow-[1.5px_1.5px_0_#191817] flex items-center justify-center font-mono font-black text-lg mb-3">
              01
            </div>
            <div class="font-mono text-[11px] font-black uppercase tracking-wider text-[#05cdff] mb-0.5">
              DEVICE-NATIVE
            </div>
            <h3 class="text-xl font-black text-[#191817] mb-1">
              No Projector Needed
            </h3>
            <p class="text-xs sm:text-sm text-[#77736c] font-medium leading-relaxed">
              Questions & choices right on player screens. No TV or shared display needed.
            </p>
          </div>
        </div>

        <!-- Card 2: LIVE & SYNCHRONIZED -->
        <div class="kz-card-tactile p-5 bg-white flex flex-col justify-between shadow-[3.5px_3.5px_0_#191817]">
          <div>
            <div class="w-10 h-10 rounded-xl bg-[#eeeafd] text-[#6c4de8] border-2 border-[#191817] shadow-[1.5px_1.5px_0_#191817] flex items-center justify-center font-mono font-black text-lg mb-3">
              02
            </div>
            <div class="font-mono text-[11px] font-black uppercase tracking-wider text-[#6c4de8] mb-0.5">
              SYNCHRONIZED
            </div>
            <h3 class="text-xl font-black text-[#191817] mb-1">
              Live Countdown Timer
            </h3>
            <p class="text-xs sm:text-sm text-[#77736c] font-medium leading-relaxed">
              Everyone plays at the same second with live WebSockets. Pure excitement.
            </p>
          </div>
        </div>

        <!-- Card 3: EASY TO JOIN -->
        <div class="kz-card-tactile p-5 bg-white flex flex-col justify-between shadow-[3.5px_3.5px_0_#191817]">
          <div>
            <div class="w-10 h-10 rounded-xl bg-[#e6ffe6] text-[#00cc05] border-2 border-[#191817] shadow-[1.5px_1.5px_0_#191817] flex items-center justify-center font-mono font-black text-lg mb-3">
              03
            </div>
            <div class="font-mono text-[11px] font-black uppercase tracking-wider text-[#08660a] mb-0.5">
              ZERO INSTALL
            </div>
            <h3 class="text-xl font-black text-[#191817] mb-1">
              5-Letter Game PIN
            </h3>
            <p class="text-xs sm:text-sm text-[#77736c] font-medium leading-relaxed">
              Join in under 3 seconds. No app store downloads, no accounts, no fuss.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: BUILT FOR MORE THAN CLASSROOMS (Interactive Audience Showcase) -->
    <AudienceSection client:visible />

    <!-- SECTION 6: CONTACT US / FEEDBACK (3-5% larger on large screens) -->
    <section class="py-12 md:py-16 border-t border-[#d8d3ca]">
      <div class="kz-card-tactile bg-white p-8 sm:p-11 border-2 border-[#191817] shadow-[5px_5px_0_#191817] rounded-3xl max-w-3xl mx-auto text-center">
        <span class="font-hand text-base sm:text-lg lg:text-[19px] font-bold text-[#6c4de8] block mb-1.5">
          say hello ✦
        </span>
        <h3 class="text-3xl sm:text-4xl lg:text-[38px] font-black text-[#191817] tracking-tight mb-3">
          Got feedback? Talk to the team.
        </h3>
        <p class="text-sm sm:text-base lg:text-[17px] text-[#77736c] font-medium max-w-lg mx-auto mb-6 leading-relaxed">
          Found a bug? Got a feature idea? Want to tell us how your first quiz went?<br class="hidden sm:inline" />
          <strong class="text-[#191817] font-bold">We actually read everything.</strong>
        </p>

        <a
          href="/contact/"
          class="kz-btn-primary px-7 py-3 rounded-xl font-bold text-sm sm:text-base lg:text-[17px] inline-flex items-center gap-2 shadow-[3px_3px_0_#191817]"
        >
          <span>Contact us</span>
          <span>&rarr;</span>
        </a>

        <p class="mt-5 text-xs sm:text-sm lg:text-[14.5px] font-hand text-[#77736c] max-w-md mx-auto">
          Replies may take 6–7 business days. Our entire team is currently one developer. 😭
        </p>
      </div>
    </section>

    <!-- SECTION 7: FREQUENTLY ASKED QUESTIONS (Second-last section) -->
    <section class="py-14 md:py-20 border-t border-[#d8d3ca]">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="font-hand text-2xl text-[#6c4de8] -rotate-2 select-none mb-1">
          got questions? ✦
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#191817] tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="text-base text-[#77736c] font-medium mt-2">
          Everything you need to know about playing and hosting online multiplayer quizzes on Koozy.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-5xl mx-auto">
        {faqItems.map((item) => (
          <div class="kz-card-tactile p-6 sm:p-7 bg-white flex flex-col justify-start">
            <h3 class="font-black text-lg sm:text-xl text-[#191817] mb-2 leading-snug">
              {item.question}
            </h3>
            <p class="text-xs sm:text-sm text-[#77736c] font-medium leading-relaxed">
              {item.answer}
            </p>
          </div>
        ))}
      </div>

      <div class="text-center mt-8">
        <a
          href="/faq/"
          class="text-xs sm:text-sm font-bold text-[#6c4de8] hover:underline inline-flex items-center gap-1.5"
        >
          <span>View all frequently asked questions</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- FAQPage JSON-LD Structured Data for Search Engines -->
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    </section>

    <!-- SECTION 8: THE MODERN ONLINE MULTIPLAYER QUIZ (Final section - SEO Editorial Guide) -->
    <section class="py-14 md:py-20 border-t border-[#d8d3ca]">
      <div class="kz-card-tactile bg-white p-7 sm:p-12 border-2 border-[#191817] shadow-[5px_5px_0_#191817] rounded-3xl">
        <div class="max-w-3xl mb-10">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#eeeafd] border border-[#c9bfff] rounded-full text-xs font-mono font-bold text-[#6c4de8] mb-3">
            <span>✦</span>
            <span>PLAY TOGETHER ANYWHERE</span>
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#191817] tracking-tight leading-tight">
            The Modern Online Multiplayer Quiz Experience
          </h2>
          <p class="text-base sm:text-lg text-[#77736c] font-medium mt-3 leading-relaxed">
            Everything you need to know about hosting, creating, and playing live trivia games on Koozy.
          </p>
        </div>

        <div class="space-y-8 text-sm sm:text-base text-[#77736c] leading-relaxed">
          <!-- Block 1 -->
          <div class="p-6 sm:p-8 bg-[#fffdf7] border-2 border-[#191817] rounded-2xl shadow-[3px_3px_0_#191817]">
            <h3 class="text-xl sm:text-2xl font-black text-[#191817] mb-3">
              What Makes Koozy the Best Multiplayer Quiz Game for Any Screen?
            </h3>
            <p class="mb-3">
              When organizing a game night, classroom review, or team icebreaker, finding the <strong class="text-[#191817]">best multiplayer quiz game</strong> should be effortless. Traditional trivia tools were originally designed around corporate meeting rooms and large lecture halls with giant overhead projectors. In those legacy setups, players only see abstract colored shape buttons on their phones while squinting across the room to read question text on a distant screen.
            </p>
            <p>
              Koozy rethinks this format from scratch as an intuitive <strong class="text-[#191817]">online multiplayer quiz</strong> built for how people actually connect today. Instead of requiring a shared display, split-screen video feeds, or cumbersome classroom setups, Koozy renders the full question and all four answer options directly on every participant's screen. Whether your group is sitting around the living room sofa, gathered in a school computer lab, or dialing in over Discord or Zoom, everyone experiences a fluid, synchronized <strong class="text-[#191817]">multiplayer quiz game online</strong>.
            </p>
          </div>

          <!-- Block 2 -->
          <div class="p-6 sm:p-8 bg-[#fffdf7] border-2 border-[#191817] rounded-2xl shadow-[3px_3px_0_#191817]">
            <h3 class="text-xl sm:text-2xl font-black text-[#191817] mb-3">
              Instant Play Without a Multiplayer Quiz Game App Download
            </h3>
            <p class="mb-3">
              One of the biggest hurdles when trying to start a <strong class="text-[#191817]">free online multiplayer quiz</strong> is friction. Most platforms force every participant to install a separate <strong class="text-[#191817]">multiplayer quiz game app</strong>, create user accounts, or verify email addresses just to join a ten-minute session. That friction kills momentum before the first question even starts.
            </p>
            <p>
              With Koozy, joining takes three seconds. The host starts a session and shares an easy-to-read, 5-letter Game PIN. Participants open any web browser on iOS, Android, macOS, Windows, or ChromeOS, enter the code with a nickname, and instantly join the lobby. Because Koozy runs entirely in modern browsers through high-speed WebSockets, you get native performance, responsive tactile animations, and real-time audio effects without downloading anything from an app store.
            </p>
          </div>

          <!-- Block 3 -->
          <div class="p-6 sm:p-8 bg-[#fffdf7] border-2 border-[#191817] rounded-2xl shadow-[3px_3px_0_#191817]">
            <h3 class="text-xl sm:text-2xl font-black text-[#191817] mb-3">
              How to Create an Online Multiplayer Quiz Game in Minutes
            </h3>
            <p class="mb-3">
              Koozy gives hosts total creative freedom to <strong class="text-[#191817]">create online multiplayer quiz game</strong> sessions tailored to any audience. As a host, you can:
            </p>
            <ul class="space-y-2.5 list-disc list-inside pl-1">
              <li>
                <strong class="text-[#191817]">Build Custom Question Sets:</strong> Write your own <strong class="text-[#191817]">online multiple choice quiz game</strong> from scratch with custom timers, rich formatting, and four balanced options.
              </li>
              <li>
                <strong class="text-[#191817]">Generate Instantly with AI:</strong> Use Koozy's built-in Google Gemini integration to turn any curriculum topic, pop culture subject, or work theme into verified 4-choice questions in under five seconds.
              </li>
              <li>
                <strong class="text-[#191817]">Moderate Live Lobbies:</strong> Manage players in real time, admit participants, kick trolls, and monitor live submission progress on an authoritative host dashboard.
              </li>
            </ul>
          </div>

          <!-- Block 4 -->
          <div class="p-6 sm:p-8 bg-[#fffdf7] border-2 border-[#191817] rounded-2xl shadow-[3px_3px_0_#191817]">
            <h3 class="text-xl sm:text-2xl font-black text-[#191817] mb-3">
              Why Groups Choose Koozy Over a Traditional Kahoot Multiplayer Quiz Game
            </h3>
            <p class="mb-3">
              If you have ever hosted a <strong class="text-[#191817]">kahoot multiplayer quiz game</strong>, you know how frustrating it is when remote participants cannot read small projector text or when strict participant limits block your group behind an expensive paywall. Koozy eliminates those barriers. As one of the top <strong class="text-[#191817]">online multiplayer question games</strong>, Koozy provides device-native clarity, unlimited live participants on asynchronous Daphne servers, and clean scoring where correct answers earn 1,000 points on a synchronized global countdown clock.
            </p>
            <p>
              Scoring on Koozy is fully automated, transparent, and immediate. As participants submit answers, progress indicators update live for the host. When the synchronized countdown expires, final scores are calculated in milliseconds. Players receive an instant scorecard highlighting correct solutions, while the host dashboard reveals a celebratory top-three podium.
            </p>
          </div>

          <!-- Block 5 -->
          <div class="p-6 sm:p-8 bg-[#fffdf7] border-2 border-[#191817] rounded-2xl shadow-[3px_3px_0_#191817]">
