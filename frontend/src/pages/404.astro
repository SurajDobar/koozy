---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — Koozy"
  description="The requested page could not be found."
  noindex={true}
  showFooterCta={false}
>
  <div class="max-w-4xl mx-auto px-6 py-16 flex flex-col items-center justify-center text-center">
    <div class="inline-block font-hand text-3xl text-[#6c4de8] -rotate-2 mb-2 select-none">
      lost in the chaos? ✦
    </div>

    <div class="kz-card p-8 md:p-10 max-w-md w-full bg-[#fffdf7] border-2 border-[#191817] shadow-[4px_4px_0_#191817] rounded-3xl my-6">
      <h1 class="text-6xl font-black text-[#191817] mb-2 tracking-tight">
        404
      </h1>
      <h2 class="text-xl font-bold text-[#191817] mb-2">
        Page Not Found
      </h2>
      <p class="text-sm text-[#77736c] mb-6">
        The page you are looking for does not exist or has moved.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/"
          class="kz-btn-primary px-6 py-2.5 rounded-xl font-bold text-sm block"
        >
          Back to Home
        </a>
        <a
          href="/join/"
          class="kz-btn-secondary px-6 py-2.5 rounded-xl font-bold text-sm block"
        >
          Join a Quiz
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
