---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageWidth?: string | number;
  ogImageHeight?: string | number;
  ogImageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  schema?: Record<string, any>;
}

const {
  title,
  description = 'Koozy is a free online multiplayer quiz platform. Create custom quizzes or generate questions with AI, share a 5-letter PIN, and play live with friends on any screen.',
  noindex = false,
  ogType = 'website',
  ogImage = '/og-image.png',
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  ogTitle,
  ogDescription,
  canonical,
  schema,
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site || 'https://koozy.live').toString().replace(/\/$/, '');
const pathname = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = canonical || new URL(pathname, siteUrl).href;
const fullTitle = title
  ? title.includes('Koozy')
    ? title
    : `${title} — Koozy`
  : 'Online Multiplayer Quiz — Play Free Live Trivia Games | Koozy';
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const socialTitle = ogTitle || fullTitle;
const socialDescription = ogDescription || description;
const resolvedImageWidth = ogImageWidth?.toString() || (resolvedOgImage.includes('512x512') ? '512' : '1200');
const resolvedImageHeight = ogImageHeight?.toString() || (resolvedOgImage.includes('512x512') ? '512' : '630');
const resolvedImageAlt = ogImageAlt || socialTitle;
---

<!-- Google Analytics (GA4) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-11PGPW5EJY"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-11PGPW5EJY');
</script>

<!-- Core Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="theme-color" content="#6c4de8" />

<!-- Robots Indexing Control -->
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}

<!-- OpenGraph / Social Cards -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={socialDescription} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:secure_url" content={resolvedOgImage} />
<meta property="og:image:width" content={resolvedImageWidth} />
<meta property="og:image:height" content={resolvedImageHeight} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={resolvedImageAlt} />
<meta property="og:site_name" content="Koozy" />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={socialDescription} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

<!-- Favicon & Touch Icons -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Google Fonts (Non-render-blocking with swap fallback) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&family=Patrick+Hand&family=Roboto:wght@400;500;700&display=swap"
/>
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&family=Patrick+Hand&family=Roboto:wght@400;500;700&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&family=Patrick+Hand&family=Roboto:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
</noscript>

<!-- Optional Schema.org JSON-LD -->
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
