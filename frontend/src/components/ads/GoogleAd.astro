---
interface Props {
  slot?: string;
  client?: string;
  format?: string;
  responsive?: boolean;
  class?: string;
}

const {
  slot = "8639181491",
  client = "ca-pub-1396295956139390",
  format = "auto",
  responsive = true,
  class: className = ""
} = Astro.props;
---

<div class={`kz-ad-container my-6 w-full overflow-hidden text-center ${className}`}>
  <!-- first itterate -->
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={client}
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive={responsive ? "true" : "false"}
  ></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
