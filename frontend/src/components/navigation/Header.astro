---
import UserProfileBadge from '../UserProfileBadge.jsx';
---

<header class="border-b border-[#d8d3ca] bg-[#f7f5ef]/90 backdrop-blur-xs sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-3 sm:gap-4">
    <!-- Brand Logo -->
    <a
      href="/"
      class="font-hand text-2xl sm:text-4xl text-[#191817] hover:text-[#6c4de8] transition-colors -rotate-2 select-none tracking-tight flex items-center gap-1.5 shrink-0"
    >
      <span>Koozy</span>
      <span class="text-xs font-sans font-extrabold uppercase px-2 py-0.5 rounded-full bg-[#eeeafd] text-[#6c4de8] border border-[#c9bfff] rotate-2">
        Live
      </span>
    </a>

    <!-- Action Group: Join with PIN & User Badge -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href="/join/"
        class="kz-btn-secondary px-3 sm:px-3.5 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-[#6c4de8]"
        >
          <line x1="6" x2="10" y1="12" y2="12" />
          <line x1="8" x2="8" y1="10" y2="14" />
          <line x1="15" x2="15.01" y1="13" y2="13" />
          <line x1="18" x2="18.01" y1="11" y2="11" />
          <rect width="20" height="12" x="2" y="6" rx="6" />
        </svg>
        <span>Join PIN</span>
      </a>

      <!-- React 19 Auth Island (hydrates asynchronously) -->
      <UserProfileBadge client:load />
    </div>
  </div>
</header>
