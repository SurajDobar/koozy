---
import GoogleAd from '../ads/GoogleAd.astro';

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
---

<footer class="mt-20 border-t-2 border-[#191817] bg-[#fffdf7]">
  {showCta && (
    <div class="max-w-5xl mx-auto px-4 sm:px-6 -translate-y-10">
      <div class="kz-card-tactile p-6 sm:p-8 bg-white text-[#191817] flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <div class="font-hand text-2xl text-[#6c4de8] -rotate-2 select-none mb-1">
            ready to make learning play? ✦
          </div>
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-[#191817]">
            Host your next live quiz on Koozy.
          </h2>
          <p class="text-xs sm:text-sm text-[#77736c] mt-1 max-w-lg leading-relaxed">
            Create questions by hand or generate a 4-option MCQ quiz with Gemini AI. Free for hosts and players.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 shrink-0 w-full sm:w-auto">
          <a
            href="/host/quizzes/"
            class="kz-btn-primary px-5 py-3 rounded-xl font-bold text-sm text-center transition-all flex-1 sm:flex-initial"
          >
            Host a Quiz
          </a>
          <a
            href="/join/"
            class="kz-btn-secondary px-5 py-3 rounded-xl font-bold text-sm text-center transition-all flex-1 sm:flex-initial"
          >
            Enter Game PIN
          </a>
        </div>
      </div>
    </div>
  )}

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Brand & Mission -->
      <div class="md:col-span-1 space-y-3">
        <a href="/" class="font-hand text-4xl text-[#191817] hover:text-[#6c4de8] transition-colors -rotate-2 inline-block select-none">
          Koozy
        </a>
        <p class="text-xs text-[#77736c] leading-relaxed">
          Tactile live multiplayer quiz platform with global countdown timers, room PINs, and Google Gemini AI generation.
        </p>
        <div class="text-[11px] font-bold uppercase tracking-wider text-[#6c4de8] bg-[#eeeafd] px-2.5 py-1 rounded-lg border border-[#c9bfff] inline-block">
          Fast &bull; Synchronized &bull; Tactile
        </div>
      </div>

      <!-- Product Links -->
      <div>
        <h3 class="text-xs font-black uppercase tracking-wider text-[#191817] mb-3">
          Platform
        </h3>
        <ul class="space-y-2 text-xs font-semibold text-[#77736c]">
          <li>
            <a href="/live-quiz/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              Live Multiplayer Quiz
            </a>
          </li>
          <li>
            <a href="/ai-quiz-maker/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              AI Quiz Maker
            </a>
          </li>
          <li>
            <a href="/how-it-works/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              How It Works
            </a>
          </li>
          <li>
            <a href="/faq/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              Frequently Asked Questions
            </a>
          </li>
        </ul>
      </div>

      <!-- Quick Play Links -->
      <div>
        <h3 class="text-xs font-black uppercase tracking-wider text-[#191817] mb-3">
          Play & Host
        </h3>
        <ul class="space-y-2 text-xs font-semibold text-[#77736c]">
          <li>
            <a href="/join/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              Join with Game PIN
            </a>
          </li>
          <li>
            <a href="/host/quizzes/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              Host Dashboard
            </a>
          </li>
          <li>
            <a href="/host/quizzes/create/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              Create New Quiz
            </a>
          </li>
          <li>
            <a href="/auth/login/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              Host Google Sign-In
            </a>
          </li>
        </ul>
      </div>

      <!-- Trust & Legal Links -->
      <div>
        <h3 class="text-xs font-black uppercase tracking-wider text-[#191817] mb-3">
          Trust & Legal
        </h3>
        <ul class="space-y-2 text-xs font-semibold text-[#77736c]">
          <li>
            <a href="/about/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              About Koozy
            </a>
          </li>
          <li>
            <a href="/contact/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              Contact & Support
            </a>
          </li>
          <li>
            <a href="/privacy/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms/" class="hover:text-[#6c4de8] hover:underline transition-colors">
              Terms of Service
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Google AdSense Ad Unit -->
    <div class="mb-8 pt-4">
      <GoogleAd />
    </div>

    <!-- Bottom Copyright & Architecture Notice -->
    <div class="pt-6 border-t border-[#d8d3ca] flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-[#77736c]">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 sm:gap-3">
        <span>&copy; 2026 Koozy &bull; Live Learning Play. All rights reserved.</span>
        <span class="hidden sm:inline">&bull;</span>
        <span class="inline-flex items-center gap-1.5 font-medium">
          made by
          <a
            href="https://surajdobar.vercel.app"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-[#191817] hover:text-[#6c4de8] underline decoration-1 decoration-[#c9bfff] hover:decoration-[#6c4de8] transition-colors"
          >
            suraj
          </a>
          <a
            href="https://x.com/surajdobar"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#191817] hover:text-[#6c4de8] transition-colors inline-flex items-center p-0.5"
            aria-label="Suraj's X (Twitter)"
            title="Follow @surajdobar on X"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </span>
      </div>
      <span class="text-center sm:text-right">Device-native questions &bull; Realtime WebSockets &bull; Zero app downloads</span>
    </div>
  </div>
</footer>
