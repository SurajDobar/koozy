---
import '../index.css';
import SEOHead from '../components/seo/SEOHead.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  schema?: Record<string, any>;
  showHeader?: boolean;
  showFooter?: boolean;
  showFooterCta?: boolean;
}

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  ogImage,
  schema,
  showHeader = true,
  showFooter = true,
  showFooterCta = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      noindex={noindex}
      ogType={ogType}
      schema={schema}
    />
    <!-- BEGIN PLERDY CODE (Deferred until window load for optimal LCP) -->
    <script data-plerdy_code="1" is:inline>
      (function(w,d){
        function initPlerdy() {
          if(w.__plerdyCode)return;
          w.__plerdyCode=1;
          w._protocol=w.location.protocol==="https:"?"https://":"http://";
          w._site_hash_code="8e04f2b192c313f2dc4a86e81c3098ad";
          w._suid=81663;
          var s=d.createElement("script");
          s.async=true;
          s.referrerPolicy="strict-origin-when-cross-origin";
          s.src="https://a.plerdy.com/public/js/click/main.js?v="+Math.random();
          d.head.appendChild(s);
        }
        if (d.readyState === "complete") {
          initPlerdy();
        } else {
          w.addEventListener("load", initPlerdy);
        }
      })(window,document);
    </script>
    <!-- END PLERDY CODE -->
  </head>
  <body class="bg-[#f7f5ef] text-[#191817] min-h-screen flex flex-col justify-between selection:bg-[#c9bfff] selection:text-[#191817]">
    {showHeader && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {showFooter && <Footer showCta={showFooterCta} />}
    <!-- Koozy Interactive Sound Engine -->
    <script>
      import '../utils/sfx.js';
    </script>
  </body>
</html>
