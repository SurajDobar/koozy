---
import '../index.css';
import SEOHead from '../components/seo/SEOHead.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  schema?: Record<string, any>;
}

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  ogImage,
  schema,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      noindex={noindex}
      ogType={ogType}
      ogImage={ogImage}
      schema={schema}
    />
  </head>
  <body class="bg-[#f7f5ef] text-[#191817] min-h-screen">
    <slot />
  </body>
</html>
