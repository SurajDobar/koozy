---
import '../index.css';
import SEOHead from '../components/seo/SEOHead.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  schema?: Record<string, any>;
  showHeader?: boolean;
  showFooter?: boolean;
  showFooterCta?: boolean;
}

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  ogImage,
  schema,
  showHeader = true,
  showFooter = true,
  showFooterCta = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      noindex={noindex}
      ogType={ogType}
      schema={schema}
    />
    <!-- Instant Game SFX Preload Cache -->
    <script is:inline>
      (function() {
        var soundUrls = [
          '/sounds/backward-swish.mp3',
          '/sounds/choose-answer-pop-button-sfx.mp3',
          '/sounds/error2_harrd.mp3',
          '/sounds/forward-swish.mp3',
          '/sounds/koozy-button.mp3',
          '/sounds/koozy-connect.mp3',
          '/sounds/koozy-disconnect.mp3',
          '/sounds/koozy-error.mp3',
          '/sounds/Koozy-loose.mp3',
          '/sounds/koozy-submitted.mp3',
          '/sounds/koozy-success.mp3',
          '/sounds/koozy-unsucess.mp3',
          '/sounds/Koozy-win.mp3',
          '/sounds/tick-immersive.mp3',
          '/sounds/url.mp3'
        ];
        function preload() {
          soundUrls.forEach(function(url) {
            var audio = new Audio();
            audio.preload = 'auto';
            audio.src = url;
          });
        }
        if (window.requestIdleCallback) {
          window.requestIdleCallback(preload);
        } else {
          setTimeout(preload, 100);
        }
      })();
    </script>
  </head>
  <body class="bg-[#f7f5ef] text-[#191817] min-h-screen flex flex-col justify-between selection:bg-[#c9bfff] selection:text-[#191817]">
    {showHeader && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {showFooter && <Footer showCta={showFooterCta} />}
    <!-- Koozy Interactive Sound Engine -->
    <script>
      import '../utils/sfx.js';
    </script>
  </body>
</html>
