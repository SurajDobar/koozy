---
import '../index.css';
import SEOHead from '../components/seo/SEOHead.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  schema?: Record<string, any>;
  showHeader?: boolean;
  showFooter?: boolean;
  showFooterCta?: boolean;
}

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  ogImage,
  schema,
  showHeader = true,
  showFooter = true,
  showFooterCta = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      noindex={noindex}
      ogType={ogType}
      ogImage={ogImage}
      schema={schema}
    />
  </head>
  <body class="bg-[#f7f5ef] text-[#191817] min-h-screen flex flex-col justify-between selection:bg-[#c9bfff] selection:text-[#191817]">
    {showHeader && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {showFooter && <Footer showCta={showFooterCta} />}
  </body>
</html>
